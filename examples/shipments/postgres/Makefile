.PHONY: fmt vet check database

fmt:
	../../../scripts/golangci.sh fmt ./...
	../../../scripts/golangci.sh run --enable-only wsl_v5 --fix ./...
	../../../scripts/golangci.sh fmt ./...
	cd ../../.. && go run ./scripts/commentspacing -write examples/shipments/postgres

vet:
	cd ../../.. && go run ./scripts/commentspacing -formatter "$$PWD/scripts/golangci.sh" examples/shipments/postgres
	../../../scripts/lint.sh ./...
	GOWORK=off go test ./...
	GOWORK=off go vet ./...
	GOWORK=off go build ./...

check: vet

database:
	./scripts/database-check.sh
